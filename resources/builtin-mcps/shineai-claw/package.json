{
  "name": "shineai-claw",
  "version": "0.5.1",
  "description": "Desktop automation MCP Server for ClaudeOps",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "shineai-claw": "dist/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npx tsc && node -e \"const fs=require('fs');const p=require('path');const d=p.join('dist','scripts');fs.mkdirSync(d,{recursive:true});fs.readdirSync(p.join('src','scripts')).filter(f=>f.endsWith('.ps1')).forEach(f=>fs.copyFileSync(p.join('src','scripts',f),p.join(d,f)))\"",
    "build:swift": "cd src/swift-helper && swift build -c release",
    "build:all": "npm run build && ([ $(uname) = 'Darwin' ] && npm run build:swift || true)",
    "dev": "npx tsx src/index.ts",
    "start": "node dist/index.js",
    "test:daemon-client": "node --test src/helpers/__tests__/DaemonClient.test.ts",
    "test:computer-use": "npm run build && node --test dist/computer-use/**/*.test.js && node --test tests/computer-use/run-computer-use-benchmark.mjs tests/windows-computer-use-fixture.test.mjs tests/e2e/computer-use-report.test.mjs",
    "smoke:computer-use": "npm run test:computer-use",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "benchmark:local": "node tests/computer-use/run-local-benchmark.mjs",
    "benchmark:regression": "node tests/computer-use/detect-benchmark-regression.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "desktop-automation",
    "claudeops"
  ],
  "license": "MIT"
}
